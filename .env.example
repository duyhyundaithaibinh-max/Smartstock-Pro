# Local owner authentication is enabled in development and production.
# Private API routes require an owner Bearer session unless the optional
# legacy shared-token fallback below is configured.
SMARTSTOCK_ENV=development

# Optional backward-compatible shared Bearer token for older clients.
# Owner Bearer sessions work independently in development and production.
# If configured, this legacy token must contain at least 32 characters.
# Keep it until all older shared-token-only clients have migrated.
SMARTSTOCK_API_TOKEN=
