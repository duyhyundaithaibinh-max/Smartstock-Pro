# Local owner authentication is enabled in development and production.
# Private API routes require an owner Bearer session unless the optional
# legacy shared-token fallback below is configured.
SMARTSTOCK_ENV=development

# Backward-compatible shared Bearer token for older clients (optional in
# development). If configured, it must contain at least 32 characters.
# Current startup policy also requires it when SMARTSTOCK_ENV=production.
SMARTSTOCK_API_TOKEN=
